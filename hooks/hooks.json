{
  "description": "V3 llmdoc hooks delegated to the installed llmdoc CLI. SessionStart may return plain text; Stop and PreCompact must return valid JSON on success.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx --no-install llmdoc hook session-start",
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx --no-install llmdoc hook stop"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx --no-install llmdoc hook compact"
          }
        ]
      }
    ]
  }
}
