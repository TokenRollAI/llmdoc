{
  "name": "llmdoc-cli",
  "version": "3.0.0",
  "description": "V3 runtime CLI for llmdoc repositories",
  "homepage": "https://github.com/TokenRollAI/llmdoc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokenRollAI/llmdoc.git"
  },
  "author": "DJJ & Danniel",
  "type": "module",
  "bin": {
    "llmdoc": "./dist/bin/llmdoc.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "schemas",
    "templates",
    "assets"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/bin/llmdoc.js', 0o755)\"",
    "prepack": "npm run build",
    "lint": "eslint src tests",
    "test": "npm run build && vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "commander": "^13.1.0",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.12",
    "minimatch": "^9.0.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^24.3.0",
    "eslint": "9.39.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.46.4",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
